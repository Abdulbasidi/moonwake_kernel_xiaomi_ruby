# ============================================================
#  SukiSU Ultra v3.2.0 (MANUAL hooks) for ruby / MoonWake 4.19.325
#
#  Kprobes are unstable/broken on this ARMv8.2 legacy 4.19 kernel,
#  so the in-kernel manual hook call sites are used instead.
#  CONFIG_KSU (v3.2.0) depends on OVERLAY_FS; EXT4_FS is already
#  on but kept explicit.
#  SUSFS is used: the kernel-side susfs (fs/susfs.c) comes from
#  DXRN-MoonWake/moonwake_kernel_xiaomi_ruby, and the SukiSU-side
#  glue is applied at build time by
#  scripts/cos17/apply_cos17_hybridswap.sh.  vendor/susfs.config
#  must be listed in extraConfig after this file.
# ============================================================
CONFIG_OVERLAY_FS=y
# CONFIG_KPROBES is not set
# CONFIG_KRETPROBES is not set
CONFIG_EXT4_FS=y
CONFIG_KSU=y
# CONFIG_KSU_KPROBES_HOOK is not set
# CONFIG_KSU_TRACEPOINT_HOOK is not set
CONFIG_KSU_MANUAL_HOOK=y
# CONFIG_KPM is not set
# CONFIG_KSU_DEBUG is not set
