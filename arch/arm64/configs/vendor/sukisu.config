# ============================================================
#  SukiSU Ultra v3.2.0 (kprobes hook) for ruby / MoonWake 4.19.325
#
#  CONFIG_KSU (v3.2.0) depends on OVERLAY_FS, and KSU_KPROBES_HOOK
#  depends on KPROBES; ruby_defconfig leaves both disabled, so we
#  enable them here. EXT4_FS is already on but kept explicit.
#  SUSFS is NOT used: SukiSU has no CONFIG_KSU_SUSFS, so
#  vendor/susfs.config must NOT be added to extraConfig.
# ============================================================
CONFIG_OVERLAY_FS=y
CONFIG_KPROBES=y
CONFIG_HAVE_KPROBES=y
CONFIG_KRETPROBES=y
CONFIG_HAVE_KRETPROBES=y
CONFIG_EXT4_FS=y
CONFIG_KSU=y
CONFIG_KSU_KPROBES_HOOK=y
# CONFIG_KSU_TRACEPOINT_HOOK is not set
# CONFIG_KSU_MANUAL_HOOK is not set
# CONFIG_KPM is not set
# CONFIG_KSU_DEBUG is not set
