# ============================================================
#  SukiSU Ultra v3.2.0 (MANUAL hooks) for ruby / MoonWake 4.19.325
#
#  Kprobes are unstable/broken on this ARMv8.2 legacy 4.19 kernel:
#  registering the SukiSU sucompat kprobes (execve/faccessat/
#  newfstatat/pts_unix98_lookup) is followed by a boot panic in
#  do_undefinstr as soon as /init runs.  Use the in-kernel manual
#  hook call sites instead (fs/exec.c, fs/open.c, fs/stat.c,
#  fs/read_write.c, drivers/input/input.c) - no runtime kprobes.
#
#  CONFIG_KSU (v3.2.0) depends on OVERLAY_FS; EXT4_FS is already
#  on but kept explicit.  SUSFS is used: the kernel-side susfs
#  (fs/susfs.c) comes from DXRN-MoonWake/moonwake_kernel_xiaomi_ruby,
#  and the SukiSU-side glue (Kconfig, ksu_cred, selinux SIDs, prctl
#  dispatch, susfs_init/susfs_start_sdcard_monitor_fn) is applied at
#  build time by scripts/cos17/apply_cos17_hybridswap.sh.
#  vendor/susfs.config must be listed in extraConfig after this file.
# ============================================================
CONFIG_OVERLAY_FS=y
# CONFIG_KPROBES is not set
# CONFIG_KRETPROBES is not set
CONFIG_EXT4_FS=y
CONFIG_KSU=y
# CONFIG_KSU_KPROBES_HOOK is not set
# CONFIG_KSU_TRACEPOINT_HOOK is not set
CONFIG_KSU_MANUAL_HOOK=y
# CONFIG_KPM is not set
# CONFIG_KSU_DEBUG is not set
